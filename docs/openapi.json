  "components": {
    "schemas": {
      "AssessmentCreateRequest": {
        "properties": {
          "social_situation": {
            "type": "string",
            "title": "Social Situation"
          },
          "current_goal": {
            "type": "string",
            "title": "Current Goal"
          },
          "self_improvement_consistency": {
            "type": "string",
            "title": "Self Improvement Consistency"
          },
          "biggest_obstacle": {
            "type": "string",
            "title": "Biggest Obstacle"
          }
        },
        "type": "object",
        "required": [
          "social_situation",
          "current_goal",
          "self_improvement_consistency",
          "biggest_obstacle"
        ],
        "title": "AssessmentCreateRequest"
      },
      "AssessmentResponse": {
        "properties": {
          "social_situation": {
            "type": "string",
            "title": "Social Situation"
          },
          "current_goal": {
            "type": "string",
            "title": "Current Goal"
          },
          "self_improvement_consistency": {
            "type": "string",
            "title": "Self Improvement Consistency"
          },
          "biggest_obstacle": {
