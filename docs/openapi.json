        "required": [
          "social_situation",
          "current_goal",
          "self_improvement_consistency",
          "biggest_obstacle"
        ],
        "title": "AssessmentResponse"
      },
      "AssessmentStatusResponse": {
        "properties": {
          "assessment_completed": {
            "type": "boolean",
            "title": "Assessment Completed"
          }
        },
        "type": "object",
        "required": [
          "assessment_completed"
        ],
        "title": "AssessmentStatusResponse"
      },
      "AssessmentSubmitResponse": {
        "properties": {
          "message": {
            "type": "string",
            "title": "Message"
          },
          "assessment_completed": {
            "type": "boolean",
            "title": "Assessment Completed"
          }
        },
        "type": "object",
        "required": [
          "message",
          "assessment_completed"
        ],
        "title": "AssessmentSubmitResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest"
      },
      "PersonaResponse": {
        "properties": {
          "persona_name": {
